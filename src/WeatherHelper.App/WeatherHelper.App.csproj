<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WeatherHelper</RootNamespace>
    <!-- 程序集名保持 ASCII：非 ASCII 构建产物路径会和 cmd.exe 代码页、部分工具链冲突。
         中文名在复制到桌面时再套用（见 build\deploy-desktop.ps1）。 -->
    <AssemblyName>WeatherHelper</AssemblyName>
    <!-- 图标：app.ico 是在 build/make-icon.ps1 里从 images/Logo.PNG 生成出来的。
         这一项把它写进 exe 的 Win32 图标资源 —— 资源管理器、快捷方式里看到的就是它。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 以下两项必须保持 false：
         PublishTrimmed —— WinForms 不支持裁剪，会以费解的方式失败；
         PublishReadyToRun —— 需要本机缺失的运行时包。 -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- 单文件发布相关：把 WindowsDesktop 的原生依赖（D3DCompiler_47_cor3.dll 等）也打进
         exe，否则它们会散落在 exe 旁边，就不是"一个 exe"了。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- 同一份 .ico 再嵌一份进程序集，运行时给窗口标题栏/任务栏用：
       单文件自包含发布不会把 app.ico 释放到 exe 旁边，所以不能按路径读。
       LogicalName 必须和 Ui/AppIcon.cs 里的 ResourceName 一致。 -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="WeatherHelper.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeatherHelper.Core\WeatherHelper.Core.csproj" />
  </ItemGroup>

</Project>